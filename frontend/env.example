NEXT_PUBLIC_MEME_FACTORY_ADDRESS=0x...
NEXT_PUBLIC_FEE_VAULT_ADDRESS=0x...
NEXT_PUBLIC_LIQUIDITY_MANAGER_ADDRESS=0x...
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:9000
NEXT_PUBLIC_APP_ENV=local
# Optional: override Sepolia RPC. Defaults to https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional: override Mainnet RPC. Defaults to https://ethereum-rpc.publicnode.com
NEXT_PUBLIC_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=YourID
NEXT_PUBLIC_NETWORK_RPC=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=31337
# Permissionless graduation addLiquidity slippage protection in basis points. 100 = 1%.
NEXT_PUBLIC_GRADUATION_ADD_LIQUIDITY_SLIPPAGE_BPS=100
# Market list API fallback controls.
NEXT_PUBLIC_MARKET_LIST_FALLBACK_LIMIT=20
NEXT_PUBLIC_ENABLE_MARKET_LIST_CHAIN_FALLBACK=false
NEXT_PUBLIC_MARKET_LIST_FALLBACK_LOGS=true

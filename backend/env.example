# Select one supported environment: local, sepolia, or mainnet.
APP_ENV=sepolia

# Select one supported chain: Anvil 31337, Sepolia 11155111, or Mainnet 1.
CHAIN_ID=11155111
RPC_URL_SEPOLIA=https://sepolia.infura.io/v3/YourKey
RPC_URL_MAINNET=https://mainnet.infura.io/v3/YourKey
RPC_URL_LOCAL=http://127.0.0.1:8545
PRIVATE_KEY_SEPOLIA=0x...
PRIVATE_KEY_MAINNET=0x...
PRIVATE_KEY_LOCAL=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Addresses deployed on the selected chain.
MEME_FACTORY_ADDRESS=0x...
FEE_VAULT_ADDRESS=0x...
LIQUIDITY_MANAGER_ADDRESS=0x...
FEE_VAULT_START_BLOCK=0
# 保持和 anvil --fork-block-number 配置一致
MARKET_INDEXER_START_BLOCK=0
# RPC 限制单次 eth_getLogs 最多查询 10 个区块【而索引器默认查询 500 个区块】
MARKET_INDEXER_BLOCK_CHUNK=10

# Market storage.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/0xcafe
REDIS_PORT=6380

# HTTP protection.
BACKEND_CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_STORE=redis
MARKET_READ_RATE_LIMIT_WINDOW_MS=60000
MARKET_READ_RATE_LIMIT_MAX=240

# Candle reads are Postgres-primary. Redis raw candle reads are local legacy only.
MARKET_CANDLE_READ_SOURCE=postgres
MARKET_CANDLE_QUERY_CACHE_VERSION=pg-v2
MARKET_CANDLE_ALLOW_REDIS_LEGACY_READ=false

# Admin keys. Monitor routes require the monitor-specific key in sepolia/mainnet.
MONITOR_ADMIN_KEY=replace-with-a-long-random-value
GROWTH_ADMIN_KEY=replace-with-a-long-random-value

# Background wallet graduation controls.
MONITOR_PUBLIC_FINALIZE=false
# Required in addition to MONITOR_PUBLIC_FINALIZE=true before public finalize can run on mainnet.
MONITOR_PUBLIC_FINALIZE_MAINNET_CONFIRM=false
# Public finalize per-IP rate limit outside local APP_ENV. Set 0 to disable.
MONITOR_PUBLIC_FINALIZE_RATE_LIMIT_PER_MINUTE=10
# Public finalize in-memory queue size when enabled.
MONITOR_PUBLIC_FINALIZE_QUEUE_LIMIT=100
# Set to redis in multi-instance deployments to dedupe public finalize by token across instances.
MONITOR_PUBLIC_FINALIZE_COORDINATION=redis
# Keeper addLiquidity slippage protection in basis points. 100 = 1%.
LIQUIDITY_ADD_SLIPPAGE_BPS=100
# Local development only. Requires APP_ENV=local and localhost requests.
MONITOR_ALLOW_UNAUTH_LOCAL=false
